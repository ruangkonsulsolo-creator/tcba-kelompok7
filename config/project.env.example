# Salin menjadi config/project.env lalu isi. File project.env TIDAK di-commit ke Git.
# Semua skrip infra/*.sh membaca file ini.

LOCATION="southeastasia"        # region yang diizinkan Azure for Students Anda (cek: infra/00_prereq_check.sh)
PREFIX="tcba7"                  # huruf kecil/angka, maks 6 karakter
RG="rg-tcba7-dev"
OWNER_EMAIL="email-jonnathan@student.uns.ac.id"   # penerima alert budget

# Budget per bulan (USD). Proyek berjalan Nov–Des: 2 x 30 = 60 < 79,99 (syarat bonus biaya).
BUDGET_AMOUNT=30
BUDGET_START="2026-11-01"
BUDGET_END="2027-02-28"

# Akun teman (email login Azure / UPN). Kosongkan jika belum ada.
RAIHAN_UPN=""
RASYID_UPN=""
# "view" = Reader + izin data minimum (sesuai arahan "multiaccount cuma buat view")
# "contributor" = Contributor pada resource group (jika dosen mengizinkan)
TEAM_ROLE_MODE="view"

# Azure Functions: "flex" (Flex Consumption, disarankan) atau "consumption" (Linux Consumption lama)
FUNC_PLAN="flex"

# Azure ML compute cluster (scale to zero). low_priority lebih murah tapi kuota mahasiswa sering 0.
AML_VM_SIZE="Standard_DS2_v2"
AML_TIER="dedicated"
AML_ENVIRONMENT="azureml://registries/azureml/environments/sklearn-1.5/labels/latest"

# Target rasio: roe_ttm | roa_ttm | npm_ttm
TARGET_RATIO="roe_ttm"
